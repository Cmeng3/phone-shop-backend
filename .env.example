SECRET_KEY=replace-with-a-generated-secret-key
DB_NAME=phone_shop
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Use require for hosted PostgreSQL connections such as Supabase.
DB_SSLMODE=prefer

# Set privately on Render to share atomic rate counters across server workers.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ANON_PER_MINUTE=30
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10
